# apps/api — copy this file to apps/api/.env and adjust as needed

# MongoDB connection string (see docker-compose.yml for the local dev instance)
MONGODB_URI=mongodb://localhost:27017/mock-api-engine

# Port the Fastify server listens on
PORT=4000

# Log level for the Fastify/pino logger: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Redis connection string (Phase 2 caching layer)
REDIS_URL=redis://localhost:6379

# How long a real AI-generated payload stays cached
CACHE_TTL_SECONDS=3600

# How long a Faker fallback payload stays cached — deliberately short so a
# transient AI outage self-heals on the next request instead of serving
# low-quality fallback data for a full hour (see cache.service.ts)
FALLBACK_CACHE_TTL_SECONDS=30

# OpenAI (Phase 2 synthetic payload generation)
OPENAI_API_KEY=
# gpt-5.6-terra: balanced cost/quality tier, good fit for structured mock-data
# generation. Use gpt-5.6-luna for cheaper/high-volume, gpt-5.6-sol for
# higher-quality generation.
OPENAI_MODEL=gpt-5.6-terra
# rules.md "Token Budget Guard" — hard ceiling on generation cost per request
AI_MAX_TOKENS=1000
AI_TIMEOUT_MS=8000

# --- Phase 3+ (not used yet) ---
# ANTHROPIC_API_KEY=
